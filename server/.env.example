# Copy file này thành .env rồi sửa lại cho đúng máy của bạn

# ===== Server =====
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Vercel Blob (lưu ảnh upload) =====
# Tạo "Blob Store" trong dashboard Vercel (tab Storage) -> copy token vào đây
# Dùng được cả khi chạy local (không chỉ khi đã deploy)
BLOB_READ_WRITE_TOKEN=

# ===== MySQL =====
# Local: DB_HOST=localhost, DB_SSL=false
# Aiven (deploy): lấy từ tab "Overview" của service MySQL trên Aiven console
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qa_forum
DB_SSL=false

# ===== JWT =====
JWT_SECRET=doi_chuoi_nay_thanh_chuoi_bi_mat_dai
JWT_EXPIRES_IN=7d
